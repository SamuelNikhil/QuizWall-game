# ============================================================
# Game Server Configuration
# ============================================================

# Direct connection URL (used when VITE_USE_PROXY=0)
# For Render: this is overridden by proxy mode
VITE_API_URL=http://localhost:3000

# Legacy fallback (not used in proxy mode)
VITE_SERVER_URL=http://localhost
VITE_SERVER_PORT=3000

# ============================================================
# Connection Mode
# ============================================================
#   'true' / 'proxy' / '1'  → proxy mode (connects via window.location.origin)
#   'false' / '0' / 'direct' → direct mode (connects to VITE_API_URL directly)
#
# For Render.com: set to 'true' so the client connects through the
# hosting proxy (render-server.js or Vite preview server).
# The proxy forwards /.wrtc/* to BACKEND_URL (set in Render env vars).
VITE_USE_PROXY=true

# Signaling Path for Geckos.io (used in both modes)
# Geckos.io v3 uses /.wrtc/v2 by default
VITE_SIGNALING_PATH=/.wrtc/v2